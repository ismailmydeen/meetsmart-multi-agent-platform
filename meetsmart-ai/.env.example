# Groq API key (free — same as the mini project). Get one at console.groq.com
GROQ_API_KEY=your-groq-key-here

# Email — stubbed by default. Flip to true once Gmail app password is ready.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password

# Database
DATABASE_URL=sqlite:///./meetsmart.db
